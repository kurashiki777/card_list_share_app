<%= form_with model: card, local: true do |f| %>
  <%= render 'shared/error_messages', object: f.object %>
  <div class="mb-4">
    <%= f.label :name, class: 'block text-gray-700 text-sm font-bold mb-2' %>
    <%= f.text_field :name, class: 'shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline' %>
  </div>
  <div class="mb-4">
    <%= f.label :card_image, class: 'block text-gray-700 text-sm font-bold mb-2' %>
    <%= f.file_field :card_image, class: 'shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline mb-3', accept: 'image/*' %>
    <%= f.hidden_field :card_image_cache %>
  </div>
  <div class='mt-3 mb-3'>
    <%= image_tag card.card_image.url, class: 'w-full h-auto' %>
  </div>
  <div class="mb-4">
    <%= f.label :remarks, class: 'block text-gray-700 text-sm font-bold mb-2' %>
    <%= f.text_area :remarks, class: 'shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline', rows: 10 %>
  </div>
  <div class="mb-4">
    <%= f.label :target_quantity, class: 'block text-gray-700 text-sm font-bold mb-2' %>
    <%= f.text_area :target_quantity, class: 'shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline' %>
  </div>
  <div class="mb-4">
    <%= f.label :stock_quantity, class: 'block text-gray-700 text-sm font-bold mb-2' %>
    <%= f.text_area :stock_quantity, class: 'shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline' %>
  </div>

  <%= f.submit class: 'bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline' %>
<% end %>