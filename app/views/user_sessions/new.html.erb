<% content_for(:title, t('.title')) %>
<div class="container mx-auto">
  <div class="flex justify-center">
    <div class="w-full max-w-lg">
      <h1 class="text-2xl font-bold mb-6 text-center"><%= t '.title' %></h1>
      <%= form_with model: @user, local: true do |f| %>
        <div class="mb-4">
          <%= f.label :email, User.human_attribute_name(:email), class: 'block text-gray-700 text-sm font-bold mb-2' %>
          <%= f.text_field :email, class: 'shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline' %>
        </div>
        <div class="mb-6">
          <%= f.label :password, User.human_attribute_name(:password), class: 'block text-gray-700 text-sm font-bold mb-2' %>
          <%= f.password_field :password, class: 'shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline' %>
        </div>
        <div class="flex items-center justify-between">
          <%= f.submit (t 'defaults.login'), class: 'bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline' %>
        </div>
      <% end %>
      <div class='text-center mt-4'>
        <%= link_to (t '.to_register_page'), new_user_path, class: 'inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800' %>
        <%= link_to (t '.password_forget'), new_password_reset_path, class: 'inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800' %>
      </div>
    </div>
  </div>
</div>