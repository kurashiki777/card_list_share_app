<div class="max-w-sm rounded overflow-hidden shadow-lg">
  <div id="card-id-<%= card.id %>" class="bg-white p-0 rounded-lg">
    <div class="card">
      <%= link_to card_path(card) do %>
        <%= image_tag card.card_image_url, class: 'w-full' %>
      <% end %>
      
      <p class="text-center text-gray-700 text-base font-semibold mb-1 tracking-tighter"><%= card.target_quantity %>:<%= card.stock_quantity %></p>
      
    </div>
  </div>
</div>